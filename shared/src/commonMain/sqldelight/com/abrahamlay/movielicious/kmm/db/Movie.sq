CREATE TABLE movie (
    id INTEGER PRIMARY KEY NOT NULL,
    vote_count INTEGER NOT NULL DEFAULT 0,
    video INTEGER NOT NULL DEFAULT 0,
    vote_average REAL NOT NULL DEFAULT 0.0,
    title TEXT,
    popularity REAL NOT NULL DEFAULT 0.0,
    poster_path TEXT,
    original_language TEXT,
    original_title TEXT,
    genre_ids TEXT,
    backdrop_path TEXT,
    adult INTEGER NOT NULL DEFAULT 0,
    overview TEXT,
    release_date TEXT,
    type TEXT NOT NULL DEFAULT 'POPULAR'
);

CREATE INDEX movie_type_index ON movie(type);

insertMovie:
INSERT OR REPLACE INTO movie (id, vote_count, video, vote_average, title, popularity, poster_path, original_language, original_title, genre_ids, backdrop_path, adult, overview, release_date, type)
VALUES (:id, :voteCount, :video, :voteAverage, :title, :popularity, :posterPath, :originalLanguage, :originalTitle, :genreIds, :backdropPath, :adult, :overview, :releaseDate, :type);

getMoviesByType:
SELECT * FROM movie WHERE type = :type;

getMovieById:
SELECT * FROM movie WHERE id = :id;

deleteAllMovies:
DELETE FROM movie;

deleteMoviesByType:
DELETE FROM movie WHERE type = :type;
